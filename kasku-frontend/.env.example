# ============================================================
# KasKu Frontend — Environment Variables
# Salin ke .env dan sesuaikan.
# PUBLIC_* vars tersedia di client-side (baked at build time).
# ============================================================

# URL api-gateway (termasuk /v1 suffix)
PUBLIC_API_BASE_URL=http://localhost:18080/v1

# Google OAuth Client ID (dari Google Cloud Console → Credentials)
# Kosongkan untuk menonaktifkan tombol Google OAuth
PUBLIC_GOOGLE_CLIENT_ID=
